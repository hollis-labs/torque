// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BlockedReasonAlert > renders blocked variant with the reason text 1`] = `"<div role="alert" aria-label="Blocked reason" class="flex gap-3 border px-4 py-3 border-red-500/40 bg-red-500/10 text-red-200 [&amp;_[data-icon]]:text-red-300" data-testid="blocked-reason-alert"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert mt-0.5 h-4 w-4 shrink-0" data-icon="true" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg><div class="flex min-w-0 flex-1 flex-col gap-1"><div class="text-[10px] font-medium uppercase tracking-[.18em]">Blocked</div><p class="whitespace-pre-wrap break-words text-[12px] leading-relaxed text-zinc-100">Permission denied: editing /etc/hosts</p></div></div>"`;

exports[`BlockedReasonAlert > renders paused variant with yellow accent 1`] = `"<div role="alert" aria-label="Paused reason" class="flex gap-3 border px-4 py-3 border-yellow-500/40 bg-yellow-500/10 text-yellow-200 [&amp;_[data-icon]]:text-yellow-300" data-testid="blocked-reason-alert"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-pause mt-0.5 h-4 w-4 shrink-0" data-icon="true" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="10" x2="10" y1="15" y2="9"></line><line x1="14" x2="14" y1="15" y2="9"></line></svg><div class="flex min-w-0 flex-1 flex-col gap-1"><div class="text-[10px] font-medium uppercase tracking-[.18em]">Paused</div><p class="whitespace-pre-wrap break-words text-[12px] leading-relaxed text-zinc-100">Awaiting human input on schema decision</p></div></div>"`;
